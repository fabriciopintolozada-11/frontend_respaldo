# Base URL and timeout (milliseconds) used by the shared Axios instance.
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000

# Use "backend" for the API or "mock" for local in-memory data.
VITE_DATA_SOURCE=backend

# JWT issued for the selected internal role. Leave empty in mock mode.
VITE_API_TOKEN=
